<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>BENji’s cutz | Barber Shop</title>
  <meta name="description" content="BENji’s cutz is a neighbourhood barber shop: sharp fades, beard shaping and hot towel shaves.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <!-- NAVIGATION -->
  <header class="site-header">
    <nav class="nav wrap" aria-label="Main">
      <a href="#home" class="logo">BENji’s cutz</a>

      <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle menu">
      <label for="nav-toggle" class="hamburger" aria-hidden="true"><span></span></label>

      <ul class="nav-links">
        <li><a href="#home">Home</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#video">Watch</a></li>
        <li><a href="#skills">Skills</a></li>
        <li><a href="#testimonials">Reviews</a></li>
        <li><a href="#contact" class="nav-cta">Book a chair</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero" id="home">
      <div class="shapes" aria-hidden="true">
        <span class="shape s1"></span>
        <span class="shape s2"></span>
        <span class="shape s3"></span>
        <span class="shape s4"></span>
      </div>

      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1 style="--i:0">Sharp cuts. Clean lines. No rush.</h1>
          <p class="lead" style="--i:1">Fades, beard work and hot towel shaves in a chair that’s always ready for you.</p>
          <div class="actions" style="--i:2">
            <a href="#contact" class="btn btn-red">Book a chair</a>
            <a href="#skills" class="btn btn-ghost">See what we do</a>
          </div>
          <p class="hours" style="--i:3">Monday to Saturday, 9am to 8pm</p>
        </div>

        <div class="pole-wrap" aria-hidden="true">
          <div class="pole"></div>
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="section about" id="about">
      <div class="wrap about-grid">
        <div>
          <h2>A neighbourhood shop with one rule: you leave looking your best</h2>
          <p>BENji’s cutz started with a single chair and a set of clippers. Today it is a place where regulars drop in for a quick line-up and newcomers settle in for the full treatment.</p>
          <p>Every cut begins with a conversation. We listen, we take our time with the details, and we finish with a hot towel and a mirror check before you go.</p>
        </div>

        <ul class="stats">
          <li><strong>8 yrs</strong><span>behind the chair</span></li>
          <li><strong>12k+</strong><span>cuts finished</span></li>
          <li><strong>4.9</strong><span>average rating</span></li>
          <li><strong>3</strong><span>chairs, no long waits</span></li>
        </ul>
      </div>
    </section>

    <!-- VIDEO -->
    <section class="section video" id="video">
      <div class="wrap">
        <h2>See the shop in action</h2>
        <p class="section-intro">A quick look inside the shop and at the work.</p>

        <div class="video-frame">
          <div class="video-inner">

            <!--
              HOW TO ADD YOUR VIDEO
              1. Put your file in a "video" folder next to index.html (for example video/shop.mp4).
              2. Delete the <div class="video-placeholder"> block below.
              3. Remove the comment markers around the <video> tag.
              (Optional) Add a poster image: poster="video/poster.jpg"

              <video controls preload="metadata" playsinline>
                <source src="video/shop.mp4" type="video/mp4">
                Your browser does not support the video tag.
              </video>

              To use a YouTube or Vimeo video instead, replace the <video> tag with an
              <iframe src="YOUR_EMBED_LINK" allowfullscreen></iframe>
            -->

            <div class="video-placeholder">
              <span class="play" aria-hidden="true"></span>
              <p>Your video goes here</p>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- SKILLS -->
    <section class="section skills" id="skills">
      <div class="wrap">
        <h2>What we’re best at</h2>
        <p class="section-intro">Years of practice, shown where it counts.</p>

        <div class="skills-grid">
          <div class="skill">
            <div class="skill-head"><h3>Skin and taper fades</h3><span>98%</span></div>
            <div class="bar"><span style="--level:98%"></span></div>
          </div>
          <div class="skill">
            <div class="skill-head"><h3>Beard shaping</h3><span>95%</span></div>
            <div class="bar"><span style="--level:95%"></span></div>
          </div>
          <div class="skill">
            <div class="skill-head"><h3>Hot towel razor shave</h3><span>92%</span></div>
            <div class="bar"><span style="--level:92%"></span></div>
          </div>
          <div class="skill">
            <div class="skill-head"><h3>Classic scissor cuts</h3><span>90%</span></div>
            <div class="bar"><span style="--level:90%"></span></div>
          </div>
          <div class="skill">
            <div class="skill-head"><h3>Kids’ cuts</h3><span>88%</span></div>
            <div class="bar"><span style="--level:88%"></span></div>
          </div>
          <div class="skill">
            <div class="skill-head"><h3>Colour and hair design</h3><span>80%</span></div>
            <div class="bar"><span style="--level:80%"></span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="section testimonials" id="testimonials">
      <div class="wrap">
        <h2>What the chair says</h2>

        <div class="quotes">
          <figure class="quote quote-featured">
            <blockquote>Best fade I’ve had in years. He took his time, checked every angle and the line-up stayed sharp for two weeks.</blockquote>
            <figcaption>Tunde A., regular since 2020</figcaption>
          </figure>
          <figure class="quote">
            <blockquote>The hot towel shave is worth the visit on its own.</blockquote>
            <figcaption>Chike O.</figcaption>
          </figure>
          <figure class="quote">
            <blockquote>My son used to hate haircuts. Now he asks when we’re going back.</blockquote>
            <figcaption>Daniel M.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="section contact" id="contact">
      <div class="wrap contact-grid">
        <div class="contact-info">
          <h2>Book your chair</h2>
          <p>Walk-ins are welcome, but booking guarantees your time slot.</p>

          <dl class="details">
            <dt>Address</dt>
            <dd>24 Barber Street, Your City</dd>
            <dt>Phone</dt>
            <dd><a href="tel:+2348000000000">+234 800 000 0000</a></dd>
            <dt>Email</dt>
            <dd><a href="mailto:hello@benjiscutz.com">hello@benjiscutz.com</a></dd>
            <dt>Hours</dt>
            <dd>Mon to Sat, 9am to 8pm<br>Sunday, 12pm to 6pm</dd>
          </dl>
        </div>

        <form class="form" action="#" method="post">
          <div class="field-row">
            <div class="field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" autocomplete="name" required>
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" required>
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="service">Service</label>
              <select id="service" name="service">
                <option>Haircut and fade</option>
                <option>Beard shaping</option>
                <option>Hot towel shave</option>
                <option>Kids’ cut</option>
                <option>Colour and design</option>
              </select>
            </div>
            <div class="field">
              <label for="date">Preferred date</label>
              <input id="date" name="date" type="date">
            </div>
          </div>

          <div class="field">
            <label for="message">Notes</label>
            <textarea id="message" name="message" rows="4"></textarea>
          </div>

          <button type="submit" class="btn btn-red">Request a booking</button>
        </form>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="wrap footer-inner">
      <p class="footer-logo">BENji’s cutz</p>
      <ul class="footer-links">
        <li><a href="#about">About</a></li>
        <li><a href="#skills">Skills</a></li>
        <li><a href="#testimonials">Reviews</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
      <p class="copy">© 2026 BENji’s cutz. All rights reserved.</p>
    </div>
  </footer>

</body>
</html>
